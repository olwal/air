# Copy to .env.local and fill in. All are optional — sensible public defaults
# are used when unset (see src/config.js).

# Base URL for the data/ directory (binary frames + CSV indexes).
# Dev default is "/data" (served from the repo root by vite.config.js).
# For production point this at wherever data/ is hosted, e.g.
# VITE_DATA_BASE=https://olwal.github.io/air/data
VITE_DATA_BASE=/data

# Optional MapTiler key if you switch the imagery/terrain source to MapTiler.
# The default satellite (Esri) and terrain (AWS Terrarium) sources need no key.
VITE_MAPTILER_KEY=
